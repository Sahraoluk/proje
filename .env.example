# VITE_GEMINI_API_KEY: Optional Gemini API key for browser/Vercel AI Advisor.
# If omitted, the app automatically uses local neighborhood matching.
VITE_GEMINI_API_KEY=""

# GEMINI_API_KEY: Optional server-side Gemini API key when running server.ts locally.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

